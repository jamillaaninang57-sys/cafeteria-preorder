# Copy this file to ".env" (same folder as server.js) and fill it in, then run: npm start
# NEVER commit ".env" to Git (it is listed in .gitignore). On the hosting platform, type these in the dashboard instead of using a file.

# ---- MySQL / MariaDB ----
# Local XAMPP: host 127.0.0.1, port 3306, user root, empty password (or create a dedicated user, see README).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cafe_app
DB_PASSWORD=
DB_NAME=cafeteria_preorder
# TLS to the database. Leave empty: it is OFF locally and ON when NODE_ENV=production. Set DB_SSL=false only if your provider has no TLS.
DB_SSL=
# Only if the provider asks for its own CA certificate: path to the .pem file.
DB_SSL_CA=

# ---- Production (set these on the host) ----
NODE_ENV=production
# The host usually sets PORT by itself. Locally it defaults to 3000.
# PORT=3000
# Signs the login cookie and pickup QR codes. 32+ random characters, different from your local one.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everybody out and makes already-issued QR codes invalid.
SESSION_SECRET=
# Your public https address (no trailing slash). It goes inside the pickup QR code.
PUBLIC_URL=

# ---- Optional ----
# Sign in with Google (APIs & Services > Credentials > OAuth client ID > Web application).
# Add http://localhost:3000 and your https domain as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# One-time starting staff access code (8+ characters) for a fresh database. Staff can change it in the app.
STAFF_CODE=
# Folder for uploaded photos. On a host with a temporary disk, point this at a persistent disk.
# UPLOAD_DIR=
